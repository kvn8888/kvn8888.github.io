# Auth.js v5 (required for /projects/* and /tools/*)
AUTH_SECRET=           # Generate with: npx auth secret
AUTH_GOOGLE_ID=        # Google Cloud Console -> OAuth 2.0 Client ID
AUTH_GOOGLE_SECRET=    # Google Cloud Console -> OAuth 2.0 Client Secret
AUTH_TRUST_HOST=true   # Required for Vercel multi-domain deployment

# Sign-in policy (required)
ALLOWED_EMAILS=user@gmail.com

# Optional email verification flow (/tools/sign-in-manager)
AUTH_EMAIL_FROM=       # Example: KevinC <noreply@kevinc.dev>
RESEND_API_KEY=        # https://resend.com/api-keys

# Google / Gemini (optional — cover letters, job parsing, Speech Lab, GCP billing)
GEMINI_API_KEY=        # Google AI Studio -> API keys
# Base64-encoded service account JSON key: cat key.json | base64 | tr -d '\n'
GCP_SERVICE_ACCOUNT_KEY=
GCP_BILLING_EXPORT_PROJECT_ID= # BigQuery billing export project override
GCP_BILLING_EXPORT_DATASET=    # BigQuery billing export dataset override (defaults to billing_export)

# Mistral (optional — Speech Lab STT + usage monitoring)
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys

# Azure Speech / OpenAI (optional — Speech Lab)
AZURE_SPEECH_KEY=      # Azure AI Speech resource -> Keys and Endpoint
AZURE_SPEECH_REGION=   # Azure AI Speech resource region (for example eastus)
AZURE_OPENAI_ENDPOINT= # Example: https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=  # Azure OpenAI resource key
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_STT_DEPLOYMENT_GPT4O_TRANSCRIBE=gpt-4o-transcribe
AZURE_OPENAI_STT_DEPLOYMENT_GPT4O_TRANSCRIBE_DIARIZE=gpt-4o-transcribe-diarize
AZURE_OPENAI_STT_DEPLOYMENT_GPT4O_MINI_TRANSCRIBE=gpt-4o-mini-transcribe

# Azure billing (optional — credits and cost monitoring)
AZURE_TENANT_ID=       # Azure Portal -> App Registrations -> Overview
AZURE_CLIENT_ID=       # Azure Portal -> App Registrations -> Overview
AZURE_CLIENT_SECRET=   # Azure Portal -> App Registrations -> Certificates & secrets
AZURE_SUBSCRIPTION_ID= # Azure Portal -> Subscriptions
AZURE_BILLING_ACCOUNT_ID= # Optional for MCA accounts
AZURE_BILLING_PROFILE_ID= # Optional for MCA accounts
AZURE_USAGE_CACHE_TTL_MS=900000 # 15 min cache to avoid Cost API 429 throttling

# Usage monitoring providers (optional)
TAVILY_API_KEY=        # https://app.tavily.com -> API Keys
GITHUB_PAT=            # Fine-grained token with personal billing or plan read access
GITHUB_USERNAME=       # GitHub username used with personal billing endpoints
OPENROUTER_API_KEY=    # https://openrouter.ai/settings/keys
ODDS_API_KEY=          # https://the-odds-api.com/account/ -> API Key
RENDER_API_KEY=        # https://dashboard.render.com/u/settings -> API Keys
REPLICATE_API_TOKEN=   # https://replicate.com/account/api-tokens
VENICE_API_KEY=        # https://venice.ai/settings/api -> API Keys

# Vercel (optional — usage monitoring + /tools/secrets env sync + cron auth)
VERCEL_API_TOKEN=      # https://vercel.com/account/tokens
VERCEL_PROJECT_ID=     # Preferred for env sync
VERCEL_PROJECT_NAME=   # Project slug fallback for env sync
VERCEL_TEAM_ID=        # Optional team scope for env sync
VERCEL_TEAM_SLUG=      # Optional team slug fallback for env sync
CRON_SECRET=           # Optional shared secret for Vercel cron routes like /api/cron/usage-snapshots

# Turso (optional — DB-backed features + usage monitoring)
TURSO_DATABASE_URL=    # libsql://... from Turso DB connection details
TURSO_AUTH_TOKEN=      # Turso DB auth token for auth approvals, notes, speech history, secrets
JOBS_TURSO_DATABASE_URL= # Optional dedicated Turso DB for job applications
JOBS_TURSO_AUTH_TOKEN=   # Optional dedicated Turso auth token for job applications
TURSO_API_TOKEN=       # https://turso.tech/app -> Settings -> API Tokens
TURSO_ORG_SLUG=        # Your org or username slug from Turso dashboard

# Job tracker automation (optional)
SHEETS_WEBHOOK_URL=    # Optional Google Sheets webhook for dual-writing job entries

# Resume uploader and S3-backed storage (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESUME_S3_BUCKET=
RESUME_S3_KEY=         # Optional object key override (defaults to resume.pdf)
RESUME_S3_PUBLIC_URL=  # Optional explicit public URL (CloudFront or custom domain)
SPEECH_S3_BUCKET=      # Optional S3 bucket for TTS audio recordings
