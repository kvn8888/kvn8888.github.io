# Auth.js v5 (required for /projects/* routes)
AUTH_SECRET=           # Generate with: npx auth secret
AUTH_GOOGLE_ID=        # Google Cloud Console → OAuth 2.0 Client ID
AUTH_GOOGLE_SECRET=    # Google Cloud Console → OAuth 2.0 Client Secret
AUTH_TRUST_HOST=true   # Required for Vercel multi-domain deployment

# Email whitelist (comma-separated, required)
ALLOWED_EMAILS=user@gmail.com

# Tavily API (optional — usage monitoring)
TAVILY_API_KEY=        # https://app.tavily.com → API Keys

# Vercel (optional — billing/usage monitoring)
VERCEL_API_TOKEN=      # https://vercel.com/account/tokens

# Render (optional — services & bandwidth monitoring)
RENDER_API_KEY=        # https://dashboard.render.com/u/settings → API Keys

# OpenRouter (optional — credits monitoring)
OPENROUTER_API_KEY=    # https://openrouter.ai/settings/keys

# Google Cloud (optional — billing accounts monitoring)
# Base64-encoded service account JSON key: cat key.json | base64 | tr -d '\n'
GCP_SERVICE_ACCOUNT_KEY=

# Azure (optional — student credits monitoring)
AZURE_TENANT_ID=       # Azure Portal → App Registrations → Overview
AZURE_CLIENT_ID=       # Azure Portal → App Registrations → Overview
AZURE_CLIENT_SECRET=   # Azure Portal → App Registrations → Certificates & secrets
AZURE_SUBSCRIPTION_ID= # Azure Portal → Subscriptions
# Optional (for MCA accounts instead of student credits):
# AZURE_BILLING_ACCOUNT_ID=
# AZURE_BILLING_PROFILE_ID=

# Turso (optional — database usage monitoring)
TURSO_API_TOKEN=       # https://turso.tech/app → Settings → API Tokens
TURSO_ORG_SLUG=        # Your org/username slug from Turso dashboard

# The Odds API (optional — sports odds API usage monitoring)
ODDS_API_KEY=          # https://the-odds-api.com/account/ → API Key

# Venice AI (optional — AI inference usage monitoring)
VENICE_API_KEY=        # https://venice.ai/settings/api → API Keys

# Resume uploader (optional — /projects/tools/resume)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESUME_S3_BUCKET=
# Optional object key override (defaults to resume.pdf)
RESUME_S3_KEY=
# Optional explicit public URL (if using CloudFront/custom domain)
RESUME_S3_PUBLIC_URL=
