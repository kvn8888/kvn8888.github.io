{
  "name": "jobs-workflow-tools",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node --import tsx scripts/generate.ts",
    "check:generated": "node --import tsx scripts/generate.ts --check",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run generate && npm --prefix extension run build && node scripts/package.mjs",
    "validate": "node --import tsx scripts/validate.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.10.1",
    "tsx": "^4.20.0"
  }
}
