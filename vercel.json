{
  "crons": [
    {
      "path": "/api/cron/usage-snapshots",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/polymarket",
      "destination": "https://polymarket-ev-bot-docker.onrender.com/polymarket"
    },
    {
      "source": "/polymarket/:path*",
      "destination": "https://polymarket-ev-bot-docker.onrender.com/polymarket/:path*"
    }
  ]
}